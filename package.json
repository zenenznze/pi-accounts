{
	"name": "@zenenznze/pi-accounts",
	"version": "1.0.0",
	"description": "Pi extension for switching named provider-owned OAuth accounts.",
	"type": "module",
	"license": "MIT",
	"private": false,
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"accounts",
		"oauth",
		"codex",
		"anthropic",
		"claude",
		"github-copilot",
		"kimi",
		"openrouter",
		"radius",
		"xai",
		"grok"
	],
	"files": [
		"src",
		"dist",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"build": "node scripts/build-runtime.mjs",
		"check": "npm run build && biome check . && npm run typecheck",
		"format": "biome check --write .",
		"prepack": "npm run build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@narumitw/pi-tui-kit": "^0.59.0",
		"proper-lockfile": "^4.1.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@earendil-works/pi-ai": "0.84.4",
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@types/proper-lockfile": "^4.1.4",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"vitest": "^4.1.11"
	},
	"publishConfig": {"access": "public", "registry": "https://registry.npmjs.org"},
	"repository": {"type": "git", "url": "git+https://github.com/zenenznze/pi-accounts.git"}
}
